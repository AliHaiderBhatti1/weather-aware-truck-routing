# Copy to backend/.env for local development. Never commit backend/.env.

# Required. Used server-side only for Directions + Geocoding.
MAPBOX_ACCESS_TOKEN=pk.your-mapbox-token

# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-api.onrender.com
# DJANGO_SECURE_SSL_REDIRECT=true   # enable in production behind TLS

# Postgres connection string in production (Neon). Falls back to SQLite when unset.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Comma separated list of browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional tuning
# API_THROTTLE_RATE=60/min
# UPSTREAM_TIMEOUT_SECONDS=20
# LOG_LEVEL=INFO
